**.subckt tb_ac_analysis
x1 net2 VOUT net3 net4 net5 opamp_two_stage
VSS net5 GND 0
VDD net2 GND 1.8
VCM net1 GND 0.9
VDIFF net4 net6 dc -0.1118m ac 1
R1 net3 net1 1mq m=1
R2 net6 net1 1mq m=1
**** begin user architecture code

.op
.control
op
print v(vout)
ac dec 100 1 1G
meas ac gain0_db FIND vdb(vout) AT=1
let lvl = gain0_db - 3
meas ac f3db WHEN vdb(vout)=lvl FALL=1
meas ac f_unity WHEN vdb(vout)=0 FALL=1
let gbw = 10^(gain0_db/20) * f3db
print gbw
plot vdb(VOUT)
.endc}


