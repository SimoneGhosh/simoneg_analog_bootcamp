**.subckt tb_dc_analysis
x1 net2 VOUT net3 net4 net5 opamp_two_stage
VSS net5 GND 0
VDD net2 GND 1.8
VCM net1 GND 0.9
VDIFF net4 net6 0
R1 net3 net1 1mq m=1
R2 net6 net1 1mq m=1
**** begin user architecture code

.op
.control
dc VDIFF -1m 1m 1u
let gain = deriv(v(vout))
let maxgain = maximum(abs(gain))
let gain_db = 20*log10(maxgain)
print maxgain gain_db
meas dc vos WHEN v(vout)=0.9
meas dc idd FIND i(vdd) AT=0
let pwr = abs(idd)*1.8
print pwr
.endc}


